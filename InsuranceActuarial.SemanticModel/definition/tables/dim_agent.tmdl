/// Producing agents
table dim_agent

	column AGENT_KEY
		dataType: int64
		sourceColumn: AGENT_KEY
		summarizeBy: none

	column AGENT_NUMBER
		dataType: string
		sourceColumn: AGENT_NUMBER
		summarizeBy: none

	column AGENT_NAME
		dataType: string
		sourceColumn: AGENT_NAME
		summarizeBy: none

	column AGENCY_NAME
		dataType: string
		sourceColumn: AGENCY_NAME
		summarizeBy: none

	column TIER
		dataType: string
		sourceColumn: TIER
		summarizeBy: none

	column HIRE_DATE
		dataType: dateTime
		sourceColumn: HIRE_DATE
		summarizeBy: none

	partition 'dim_agent-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_agent

