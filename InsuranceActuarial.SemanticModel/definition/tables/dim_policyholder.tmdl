/// Insureds
table dim_policyholder

	column POLICYHOLDER_KEY
		dataType: int64
		sourceColumn: POLICYHOLDER_KEY
		summarizeBy: none

	column POLICYHOLDER_NUMBER
		dataType: string
		sourceColumn: POLICYHOLDER_NUMBER
		summarizeBy: none

	column FIRST_NAME
		dataType: string
		sourceColumn: FIRST_NAME
		summarizeBy: none

	column LAST_NAME
		dataType: string
		sourceColumn: LAST_NAME
		summarizeBy: none

	column GENDER
		dataType: string
		sourceColumn: GENDER
		summarizeBy: none

	column EMAIL
		dataType: string
		sourceColumn: EMAIL
		summarizeBy: none

	column DATE_OF_BIRTH
		dataType: dateTime
		sourceColumn: DATE_OF_BIRTH
		summarizeBy: none

	column ACQUIRED_DATE
		dataType: dateTime
		sourceColumn: ACQUIRED_DATE
		summarizeBy: none

	partition 'dim_policyholder-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_policyholder

