/// Issued policies (one row per policy term)
table fact_policy

	column POLICY_KEY
		dataType: int64
		sourceColumn: POLICY_KEY
		summarizeBy: none

	column POLICY_NUMBER
		dataType: string
		sourceColumn: POLICY_NUMBER
		summarizeBy: none

	column POLICY_STATUS
		dataType: string
		sourceColumn: POLICY_STATUS
		summarizeBy: none

	column TERM_MONTHS
		dataType: int64
		sourceColumn: TERM_MONTHS
		summarizeBy: none

	column EXPOSURE_UNITS
		dataType: int64
		sourceColumn: EXPOSURE_UNITS
		summarizeBy: none

	column ANNUAL_PREMIUM
		dataType: int64
		sourceColumn: ANNUAL_PREMIUM
		summarizeBy: none

	column POLICYHOLDER_KEY
		dataType: string
		isHidden
		sourceColumn: POLICYHOLDER_KEY
		summarizeBy: none

	column AGENT_KEY
		dataType: string
		isHidden
		sourceColumn: AGENT_KEY
		summarizeBy: none

	column PRODUCT_KEY
		dataType: string
		isHidden
		sourceColumn: PRODUCT_KEY
		summarizeBy: none

	column GEOGRAPHY_KEY
		dataType: string
		isHidden
		sourceColumn: GEOGRAPHY_KEY
		summarizeBy: none

	column EFFECTIVE_DATE_KEY
		dataType: string
		isHidden
		sourceColumn: EFFECTIVE_DATE_KEY
		summarizeBy: none

	/// Number of policies
	measure 'policy_count' = COUNTROWS('fact_policy')

	/// Total exposure units (car-years, house-years)
	measure 'total_exposure' = SUM('fact_policy'[EXPOSURE_UNITS])

	/// Sum of annualized premium amounts
	measure 'total_annual_premium' = SUM('fact_policy'[ANNUAL_PREMIUM])

	partition 'fact_policy-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: fact_policy

