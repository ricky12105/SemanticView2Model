/// Coverage type within a policy
table dim_coverage

	column COVERAGE_KEY
		dataType: int64
		sourceColumn: COVERAGE_KEY
		summarizeBy: none

	column COVERAGE_CODE
		dataType: string
		sourceColumn: COVERAGE_CODE
		summarizeBy: none

	column COVERAGE_NAME
		dataType: string
		sourceColumn: COVERAGE_NAME
		summarizeBy: none

	column PERIL_CATEGORY
		dataType: string
		sourceColumn: PERIL_CATEGORY
		summarizeBy: none

	partition 'dim_coverage-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_coverage

