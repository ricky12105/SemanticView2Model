/// US states & catastrophe zones
table dim_geography

	column geography_key
		dataType: int64
		sourceColumn: GEOGRAPHY_KEY
		summarizeBy: none

	column state_code
		dataType: string
		sourceColumn: STATE_CODE
		summarizeBy: none

	column state_name
		dataType: string
		sourceColumn: STATE_NAME
		summarizeBy: none

	column region
		dataType: string
		sourceColumn: REGION
		summarizeBy: none

	/// Catastrophe zone classification (null for non-CAT-exposed states)
	column cat_zone
		dataType: string
		sourceColumn: CAT_ZONE
		summarizeBy: none

	partition 'dim_geography-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_geography

