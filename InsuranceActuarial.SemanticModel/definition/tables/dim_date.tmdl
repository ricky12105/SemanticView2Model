/// Calendar dimension
table dim_date

	column DATE_KEY
		dataType: int64
		sourceColumn: DATE_KEY
		summarizeBy: none

	column YEAR_MONTH
		dataType: string
		sourceColumn: YEAR_MONTH
		summarizeBy: none

	column MONTH_NAME
		dataType: string
		sourceColumn: MONTH_NAME
		summarizeBy: none

	column QUARTER_NUM
		dataType: int64
		sourceColumn: QUARTER_NUM
		summarizeBy: none

	/// Use as a filter to restrict to month-end snapshots
	column IS_MONTH_END
		dataType: boolean
		sourceColumn: IS_MONTH_END
		summarizeBy: none

	/// Calendar date
	column DATE_VAL
		dataType: dateTime
		sourceColumn: DATE_VAL
		summarizeBy: none

	column YEAR_NUM
		dataType: int64
		sourceColumn: YEAR_NUM
		summarizeBy: none

	partition 'dim_date-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_date

