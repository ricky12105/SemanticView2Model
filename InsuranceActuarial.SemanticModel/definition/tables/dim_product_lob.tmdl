/// Line of business / product
table dim_product_lob

	column PRODUCT_KEY
		dataType: int64
		sourceColumn: PRODUCT_KEY
		summarizeBy: none

	column LOB_CODE
		dataType: string
		sourceColumn: LOB_CODE
		summarizeBy: none

	column LOB_NAME
		dataType: string
		sourceColumn: LOB_NAME
		summarizeBy: none

	column LINE_GROUP
		dataType: string
		sourceColumn: LINE_GROUP
		summarizeBy: none

	partition 'dim_product_lob-DirectLake' = entity
		mode: directLake
		source
			expressionSource: DatabaseQuery
			schemaName: Actuarial
			entityName: dim_product_lob

